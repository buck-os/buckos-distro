[cells]
  buckos = .
  prelude = prelude
  toolchains = toolchains

# `config` and `ovr_config` are the platform/constraint namespaces the
# prelude's own select()s read.  `buck`, `fbcode` and `fbsource` look like
# leftovers from somewhere else and are not: the prelude bundled inside the
# buck2 binary names them itself (its android rules reference
# `fbsource//tools/build_defs/android/config:build_mode_opt`), so removing
# them fails the build with "unknown cell alias" before any target of ours
# is even analysed.  They are load-bearing prelude vocabulary, pointed at
# this repo's own root cell so the patterns resolve.
[cell_aliases]
  buck = prelude
  config = prelude
  fbcode = buckos
  fbsource = buckos
  ovr_config = prelude

# Use the prelude bundled inside the open-source buck2 binary rather than
# vendoring facebook/buck2-prelude as a submodule.  The prelude/ directory
# must exist as a mount point but its contents come from buck2 itself.
[external_cells]
  prelude = bundled

[build]
  default_target_platform = //platforms:linux-x86_64
  execution_platforms = //platforms:platforms

# ── Remote execution ─────────────────────────────────────────────────
# Deliberately absent rather than disabled: a `[buck2_re_client]` with no
# reachable engine fails differently and less clearly than no section at
# all.  Filling this in is the *second* step -- the first is
#   [buckos]
#     remote_execution = true
#     remote_cache = true
# in .buckconfig.local, which is what //platforms:platforms reads.
#
# [buck2_re_client]
#   engine_address       = <host:port>
#   action_cache_address = <host:port>
#   cas_address          = <host:port>
#   instance_name        = <pool>
#   tls                  = true
#   tls_ca_certs         = </absolute/path/control-ca.pem>
#   tls_client_cert      = </absolute/path/combined-client-identity.pem>
#
# See REMOTE_EXECUTION.md for the reference deployment, worker preflight,
# cache policy, rollout sequence, and acceptance gates.

[parser]
  target_platform_detector_spec = target:buckos//...->buckos//platforms:linux-x86_64 target:toolchains//...->buckos//platforms:linux-x86_64

[project]
  # **/lock/repodata holds the raw primary.xml a solve consumes -- tens of
  # megabytes that buck2 would otherwise rescan on every build.  The
  # *lockfile* it produces is checked in and is not ignored.
  #
  # .fedora-cache and .mirror-cache are the blob endpoint's content-addressed
  # store.  .gitignore does not help here -- buck2 keeps its own watch list --
  # and without these entries every build reports a thousand-odd file change
  # events for rpms it fetched itself, which is both slow and misleading when
  # reading a log for what actually changed.
  ignore = .git, buck-out, **/__pycache__, .claude, .buckos, downloads, **/lock/repodata, local_scripts, .fedora-cache, .mirror-cache

# ── Distro flavor selection ──────────────────────────────────────────
# Which flavor `//:default` resolves to.  Override per-invocation with
#   buck2 build //... -c buckos.flavor=ubuntu
[buckos]
  flavor = fedora

# ── Fedora flavor configuration ──────────────────────────────────────
# releases     Every release to define targets for, oldest first.  Each one
#              gets its own :buildroot-*-<release> targets, and they coexist
#              in a single build graph -- building two Fedoras at once is a
#              supported operation, not a mode switch.  Only non-EOL
#              releases work: EOL ones move to archives.fedoraproject.org
#              and their repodata paths 404.
# release      Which release the unsuffixed targets alias.  Defaults to the
#              newest entry in `releases`, so adding a release moves the
#              default forward on its own.  Set it only to pin an older one.
# buildroot    Buildroot provenance, see SPEC.md section 3:
#                binary-seed  fetch @buildsys-build RPMs by hash (production)
#                host         use the host's installed rpm toolchain
#                             (non-hermetic, local_only, development only)
#
# binary-seed is the default rather than host, and the reason is
# compatibility rather than purity.  The host here is whatever machine ran
# the build -- on CentOS Stream 9 that is rpm 4.16 and gcc 11 -- and with
# `host` those produce artifacts stamped for the selected Fedora release.
# Two ways that bites:
# rpm 4.16 writes an rpmdb the target release's rpm may not read back, and
# a package compiled against the host's glibc can reference a symbol
# version the target's glibc does not have.  Both fail at *runtime*, in the
# image, long after a green build.
#
# binary-seed pins Fedora's own gcc, glibc and rpm at the versions that
# release shipped, so the toolchain matches the distro being built.  It is
# also what makes the graph remote-executable: a seeded buildroot is
# hermetic, and defs/buildroot_helpers.bzl turns that into local_only =
# False with cache upload enabled, where `host` forces the opposite.
[buckos.fedora]
  releases = 44,45
  # 45 has branched from rawhide but has not reached GA, so it is served
  # from development/ rather than releases/ and has no updates tree --
  # tools/relock.py --branched 45 is what records that.  It is deliberately
  # not the default: `release` would otherwise follow the newest entry and
  # point every unsuffixed target at a release whose packages still move
  # daily.  Drop this line at F45 GA.
  release = 44
  buildroot = binary-seed

  # gnutls.spec enables mingw whenever %{fedora} is defined, so the replay
  # configures build_win32 and build_win64 cross trees beside the native
  # one.  Fedora 44's i686-w64-mingw32 gcc 16.1.1 segfaults compiling
  # gnulib's localename-unsafe.c:
  #
  #   during GIMPLE pass: strlen
  #   internal compiler error: Segmentation fault
  #
  # The native x86_64 tree builds fine -- only the Windows DLLs fail, and
  # a Linux image has no use for them.  This lives here rather than in
  # .buckconfig.local because it is not a fact about any one machine: the
  # compiler is a pinned Fedora package, so every host hits the same ICE,
  # and a fresh clone cannot build gnutls without it.
  #
  # Two costs, stated rather than discovered.  gnutls still builds from
  # source but no longer produces mingw32-gnutls or mingw64-gnutls, so
  # those two projection targets are unbuildable; nothing in the live or
  # image-tools sets asks for them.  And `without` is flavor-wide rather
  # than per-release, so this also disables the cross build on 45, whose
  # older compiler may not have the bug.  Narrowing it needs a
  # per-release form of this setting, which does not exist yet.
  #
  # libkcapi:doc is the same shape and a different cause.  Its C build
  # succeeds; what fails is the LaTeX half, where pdf-stamp and ps-stamp
  # both die with "Error 9" under the replay's `make -O -j316`, and the
  # Makefile carries duplicate recipes for lib/doc/bin/docproc.  That
  # looks like a doc build that is not parallel-safe, but the shape is
  # inferred rather than proven -- what is established is that only the
  # documentation targets fail.  Dropping them costs libkcapi-doc, which
  # neither image set installs; the three subpackages the live image does
  # use (libkcapi, libkcapi-hasher, libkcapi-hmaccalc) are unaffected.
  without = gnutls:mingw, libkcapi:doc

# Release 9 layers EPEL and EPEL Next; release 10 is plain Stream and stays
# the default because releases are listed oldest first.
[buckos.centos]
  releases = 9,10
  buildroot = binary-seed

# CentOS Hyperscale layers its main SIG repository and release package on
# CentOS Stream. Release 9 uses EPEL and EPEL Next; release 10 uses EPEL.
[buckos.centos-hyperscale]
  releases = 9,10
  buildroot = binary-seed

[buckos.ubuntu]
  releases = 26.04
  buildroot = binary-seed

[buckos.debian]
  releases = 13
  buildroot = binary-seed

# ── Source mirror ────────────────────────────────────────────────────
# upstream  fetch source packages from the distro's own mirrors
# vendor    read pre-downloaded source packages from vendor_dir
[mirror]
  mode = upstream
  vendor_dir = vendor
