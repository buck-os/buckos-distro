# Runtime closures, one per named image set.  A different
# question from SEED_RPMS over the same universe: what has to
# be installed for the machine to boot, rather than for the
# compiler to run.  These are installed by rpm with a real
# rpmdb and scriptlets, not unpacked.
IMAGE_SETS = {
}

# Source rpms replayed by rpmbuild -bb.
SOURCE_RPMS = [
]

# One package() call per entry.
RECIPES = [
]

# Cycle staging.  A source package listed here is not built
# once but N times, each stage against the previous one's
# output, because it and its build dependencies form a cycle
# that buck2 would reject at parse time.  `cycle_deps_from`
# names the stage a cycle dependency is taken from -- "seed"
# meaning the pinned upstream binary.  Exactly one stage per
# source has ships=True; that is the one the plain target
# name aliases to.
STAGED = [
]
