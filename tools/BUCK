# Shared modules use base_module = "" so `import _rpm` works from a
# python_binary's main -- the same pattern as buckos-build's tools/BUCK.

python_library(
    name = "_rpm",
    srcs = ["_rpm.py"],
    base_module = "",
    visibility = ["PUBLIC"],
)

# Entering a buildroot as / -- shared by the spec replay and by rootfs
# installation, which must agree about what the sandbox guarantees.
python_library(
    name = "_isolation",
    srcs = ["_isolation.py"],
    base_module = "",
    visibility = ["PUBLIC"],
    deps = [":_rpm"],
)

python_library(
    name = "depgraph",
    srcs = ["depgraph.py"],
    base_module = "",
    visibility = ["PUBLIC"],
)

