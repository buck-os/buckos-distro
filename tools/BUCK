# ── Solver (runs out-of-band, not in the build graph) ────────────────
#
# solve.py reads pinned repodata and writes the checked-in lockfile.  It is
# deliberately NOT a build action: the solve is the "generate" step of the
# solve / generate / build split in SPEC.md section 3a, run by a human and
# reviewed as a diff, like cargo update or reindeer vendor.

# rpm's version comparison, kept apart from the solver because it is
# transcribed from lib/rpmvercmp.c and is tested against rpm's own corpus
# rather than against anything this repo believes.
python_library(
    name = "rpmvercmp",
    srcs = ["rpmvercmp.py"],
    base_module = "",
)

# A library with a thin binary over it, rather than main = "solve.py", so
# the closure functions can be imported by a test.  The solve's correctness
# is not observable from its output -- a wrong closure is still a valid
# lockfile -- so the parts that decide membership need direct coverage.
python_library(
    name = "solve_lib",
    srcs = ["solve.py"],
    base_module = "",
    deps = [
        ":depgraph",
        ":rpmvercmp",
    ],
)

python_binary(
    name = "solve",
    main_module = "solve",
    deps = [":solve_lib"],
    visibility = ["PUBLIC"],
)

# The update loop: fetch upstream repodata, re-solve, regenerate.
#
#     buck2 run //tools:relock -- --release 43
#
# Runnable but not buildable-into-anything, for the same reason solve is:
# it reaches the network and writes checked-in files, so it is a human's
# generate step whose output is reviewed as a diff.  Making it an action
# would put upstream's publishing schedule inside the build graph and cost
# the property that a given commit builds the same distro tomorrow.
python_library(
    name = "relock_lib",
    srcs = [
        "generate.py",
        "relock.py",
    ],
    base_module = "",
    deps = [":solve_lib"],
)

python_binary(
    name = "relock",
    main_module = "relock",
    deps = [":relock_lib"],
    visibility = ["PUBLIC"],
)

python_test(
    name = "depgraph_test",
    srcs = ["depgraph_test.py"],
    base_module = "",
    deps = [":depgraph"],
)

python_test(
    name = "solve_test",
    srcs = ["solve_test.py"],
    base_module = "",
    deps = [":solve_lib"],
)

# Run against rpm's own tests/rpmvercmp.at corpus rather than cases
# invented here: the rules are odd enough that cases written from the
# documentation would agree with the documentation instead of with rpm.
python_test(
    name = "rpmvercmp_test",
    srcs = ["rpmvercmp_test.py"],
    base_module = "",
    deps = [":rpmvercmp"],
)

# A source lint, not a unit test: it reads the checked-in .bzl files and
# fails the build if a rule's remote-execution disposition is hardcoded
# rather than derived from the buildroot it consumes.  See the module
# docstring for why this cannot be left to convention.
python_test(
    name = "re_contract_test",
    srcs = ["re_contract_test.py"],
    base_module = "",
)

# Also a source lint.  Guards where scratch trees live, which sounds like a
# style question and is not: an rpm payload can contain a filename buck2
# cannot represent, and putting the tree under buck-out turns that into a
# build failure that survives deleting the file and re-arms itself on
# `buck2 kill`.  The module docstring has the whole loop.
python_test(
    name = "scratch_contract_test",
    srcs = ["scratch_contract_test.py"],
    base_module = "",
    deps = [":_rpm"],
)
