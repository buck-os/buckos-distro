# ── Image pipeline ───────────────────────────────────────────────────

# Reading a rootfs tarball's index without unpacking it.  Separate from
# _rpm because it needs nothing from rpm: the questions the boot pipeline
# asks of an image -- which kernel, where is its vmlinuz -- are answered by
# the tar's own headers.
python_library(
    name = "_image",
    srcs = ["_image.py"],
    base_module = "",
    visibility = ["PUBLIC"],
)

python_binary(
    name = "rootfs_install",
    main = "rootfs_install.py",
    deps = [
        ":_isolation",
        ":_rpm",
    ],
    visibility = ["PUBLIC"],
)

python_binary(
    name = "kernel_extract",
    main = "kernel_extract.py",
    deps = [":_image"],
    visibility = ["PUBLIC"],
)

python_binary(
