# ── Solver (runs out-of-band, not in the build graph) ────────────────
#
# solve.py reads pinned repodata and writes the checked-in lockfile.  It is
# deliberately NOT a build action: the solve is the "generate" step of the
# solve / generate / build split in SPEC.md section 3a, run by a human and
# reviewed as a diff, like cargo update or reindeer vendor.

# rpm's version comparison, kept apart from the solver because it is
# transcribed from lib/rpmvercmp.c and is tested against rpm's own corpus
# rather than against anything this repo believes.
python_library(
    name = "rpmvercmp",
    srcs = ["rpmvercmp.py"],
    base_module = "",
)

# A library with a thin binary over it, rather than main = "solve.py", so
# the closure functions can be imported by a test.  The solve's correctness
# is not observable from its output -- a wrong closure is still a valid
# lockfile -- so the parts that decide membership need direct coverage.
python_library(
    name = "solve_lib",
    srcs = ["solve.py"],
    base_module = "",
    deps = [
        ":depgraph",
        ":rpmvercmp",
        ":source_policy",
    ],
)

python_binary(
    name = "solve",
    main_module = "solve",
    deps = [":solve_lib"],
    visibility = ["PUBLIC"],
)

python_binary(
    name = "deb_lock",
    main = "deb_lock.py",
    deps = [":_deb"],
    visibility = ["PUBLIC"],
)

python_binary(
    name = "deb_generate",
    main = "deb_generate.py",
    visibility = ["PUBLIC"],
)

# The update loop: fetch upstream repodata, re-solve, regenerate.
#
#     buck2 run //tools:relock -- --release 44 --arch x86_64
#
# Runnable but not buildable-into-anything, for the same reason solve is:
# it reaches the network and writes checked-in files, so it is a human's
# generate step whose output is reviewed as a diff.  Making it an action
# would put upstream's publishing schedule inside the build graph and cost
# the property that a given commit builds the same distro tomorrow.
#
# probe.py is in the same library because it shares relock's repo-root and
# release-discovery logic and must not disagree with it -- a probe run that
# covered a different set of releases than the refresh did would write
# results for one lockfile and not the other.
python_library(
    name = "relock_lib",
    srcs = [
        "generate.py",
        "probe.py",
        "relock.py",
    ],
    base_module = "",
    deps = [":solve_lib"],
)

python_binary(
    name = "relock",
    main_module = "relock",
    deps = [":relock_lib"],
    visibility = ["PUBLIC"],
)

python_library(
    name = "rpm_relock_lib",
    srcs = ["rpm_relock.py"],
    base_module = "",
    deps = [":relock_lib"],
)

python_binary(
    name = "rpm_relock",
    main_module = "rpm_relock",
    deps = [":rpm_relock_lib"],
    visibility = ["PUBLIC"],
)

# Discovering what %generate_buildrequires asks for, by running it.
#
#     buck2 run //tools:probe -- --flavor fedora --release 44 --arch x86_64
#
# Out of the build graph for a stronger reason than relock's: this one
# *invokes buck2*. It builds every //flavors/<flavor>:probe-<pkg> target and
# merges the reports, so as an action it would be a build inside a build.
# The recursion is not incidental either -- the answer only exists once the
# package's buildroot has been assembled and its %prep has run, which is to
# say once most of a build has happened.  See the module docstring.
python_binary(
    name = "probe",
    main_module = "probe",
    deps = [":relock_lib"],
    visibility = ["PUBLIC"],
)

# What this host can do, and which packages need it.
#
#     buck2 run //tools:hostcheck
#
# Out of the build graph deliberately: it probes the *running* kernel, so
# as an action its answer would be cached against inputs that do not
# describe it.  It writes advice for .buckconfig.local instead.
python_binary(
    name = "hostcheck",
    main = "hostcheck.py",
    deps = [":_isolation"],
    visibility = ["PUBLIC"],
)

