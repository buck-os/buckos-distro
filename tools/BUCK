    name = "re_contract_test",
    srcs = ["re_contract_test.py"],
    base_module = "",
)

# Also a source lint.  Guards where scratch trees live, which sounds like a
# style question and is not: an rpm payload can contain a filename buck2
# cannot represent, and putting the tree under buck-out turns that into a
# build failure that survives deleting the file and re-arms itself on
# `buck2 kill`.  The module docstring has the whole loop.
python_test(
    name = "scratch_contract_test",
    srcs = ["scratch_contract_test.py"],
    base_module = "",
    deps = [":_rpm"],
)
