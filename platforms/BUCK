# ── Buildroot provenance ─────────────────────────────────────────────
#
# SPEC.md section 3.  Exposed as constraints so a target can be declared
# incompatible with a non-hermetic buildroot rather than silently
# producing an unreproducible artifact.

constraint_setting(
    name = "provenance",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "binary-seed",
    constraint_setting = ":provenance",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "bootstrapped",
    constraint_setting = ":provenance",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "host",
    constraint_setting = ":provenance",
    visibility = ["PUBLIC"],
)

config_setting(
    name = "is-host-provenance",
    constraint_values = [":host"],
    visibility = ["PUBLIC"],
)

# ── Execution platform registry ──────────────────────────────────────
#
# Registered in .buckconfig as:
#   [build]
#   execution_platforms = //platforms:platforms
#
# Both flags default off so a fresh clone builds locally with no
# infrastructure.  Turn them on in .buckconfig.local:
#   [buckos]
#     remote_execution = true
#     remote_cache = true

distro_execution_platforms(
    name = "platforms",
    aarch64_emulation_enabled = read_config("buckos", "aarch64_emulation", "false") == "true",
    aarch64_execution_capability = ":can-execute-aarch64",
    aarch64_platform = ":linux-aarch64",
    remote_cache_enabled = read_config("buckos", "remote_cache", "") == "true",
    remote_execution_enabled = read_config("buckos", "remote_execution", "") == "true",
    remote_aarch64_properties = read_config("buckos", "remote_aarch64_properties", "platform.OSFamily=linux,platform.arch=aarch64"),
    remote_aarch64_use_case = read_config("buckos", "remote_aarch64_use_case", "buck2-default"),
    remote_x86_64_properties = read_config("buckos", "remote_x86_64_properties", "platform.OSFamily=linux,platform.arch=x86_64"),
    remote_x86_64_use_case = read_config("buckos", "remote_x86_64_use_case", "buck2-default"),
    visibility = ["PUBLIC"],
    x86_64_execution_capability = ":can-execute-x86_64",
    x86_64_platform = ":linux-x86_64",
)
