load("//defs:exec.bzl", "distro_execution_platforms")
load("//defs:architectures.bzl", "ARCHITECTURES")
load("//defs:releases.bzl", "flavor_releases")

# ── Target platforms ─────────────────────────────────────────────────

platform(
    name = "linux-x86_64",
    constraint_values = [
        "prelude//cpu/constraints:x86_64",
        "prelude//os/constraints:linux",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "linux-aarch64",
    constraint_values = [
        "prelude//cpu/constraints:arm64",
        "prelude//os/constraints:linux",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "is_x86_64",
    constraint_values = ["prelude//cpu/constraints:x86_64"],
    visibility = ["PUBLIC"],
)

# An execution platform's CPU says which architecture its action runner is.
# These independent capability constraints say which target binaries that
# runner can execute. A native AArch64 worker and an x86_64 worker with a
# registered AArch64 binfmt handler therefore satisfy the same action.

constraint_setting(
    name = "exec-x86_64",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "can-execute-x86_64",
    constraint_setting = ":exec-x86_64",
    visibility = ["PUBLIC"],
)

constraint_setting(
    name = "exec-aarch64",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "can-execute-aarch64",
    constraint_setting = ":exec-aarch64",
    visibility = ["PUBLIC"],
)

config_setting(
    name = "is_aarch64",
    constraint_values = ["prelude//cpu/constraints:arm64"],
    visibility = ["PUBLIC"],
)

# ── Distro flavor ────────────────────────────────────────────────────
#
# Which upstream distro's packaging a target was built from.  Carried as a
# real constraint, not just a string in a provider, so a rootfs can refuse
# to mix flavors by construction.

constraint_setting(
    name = "flavor",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "fedora",
    constraint_setting = ":flavor",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "centos",
    constraint_setting = ":flavor",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "centos-hyperscale",
    constraint_setting = ":flavor",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "ubuntu",
    constraint_setting = ":flavor",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "debian",
    constraint_setting = ":flavor",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "buckos",
    constraint_setting = ":flavor",
    visibility = ["PUBLIC"],
)

# ── Distro release ───────────────────────────────────────────────────
#
# Which release of a flavor a target was built against.  Fedora 44 and
# Fedora 45 are different build universes -- different compiler, different
# macros, different pinned dependency set -- so "which release" is carried
# as a constraint rather than a global mode the repo is switched into.
# That is what lets both exist in one build graph, and what lets a target
# declare itself incompatible with a release instead of silently building
# against the wrong one.
#
# Values are generated from the same config the flavors read, so adding a
# release is one edit in .buckconfig and not a list maintained twice.

constraint_setting(
    name = "release",
    visibility = ["PUBLIC"],
)

[
    constraint_value(
        name = "fedora-{}".format(_release),
        constraint_setting = ":release",
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("fedora", default = "44,45")
]

[
    platform(
        name = "fedora-{}-{}".format(_release, _arch),
        constraint_values = [
            "prelude//cpu/constraints:{}".format("arm64" if _arch == "aarch64" else _arch),
            "prelude//os/constraints:linux",
            ":fedora",
            ":fedora-{}".format(_release),
        ],
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("fedora", default = "44,45")
    for _arch in ARCHITECTURES
]

[
    constraint_value(
        name = "centos-{}".format(_release),
        constraint_setting = ":release",
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("centos", default = "9,10")
]

[
    platform(
        name = "centos-{}-{}".format(_release, _arch),
        constraint_values = [
            "prelude//cpu/constraints:{}".format("arm64" if _arch == "aarch64" else _arch),
            "prelude//os/constraints:linux",
            ":centos",
            ":centos-{}".format(_release),
        ],
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("centos", default = "9,10")
    for _arch in ARCHITECTURES
]

[
    constraint_value(
        name = "centos-hyperscale-{}".format(_release),
        constraint_setting = ":release",
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("centos-hyperscale", default = "9,10")
]

[
    platform(
        name = "centos-hyperscale-{}-{}".format(_release, _arch),
        constraint_values = [
            "prelude//cpu/constraints:{}".format("arm64" if _arch == "aarch64" else _arch),
            "prelude//os/constraints:linux",
            ":centos-hyperscale",
            ":centos-hyperscale-{}".format(_release),
        ],
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("centos-hyperscale", default = "9,10")
    for _arch in ARCHITECTURES
]

[
    constraint_value(
        name = "ubuntu-{}".format(_release),
        constraint_setting = ":release",
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("ubuntu", default = "26.04")
]

[
    platform(
        name = "ubuntu-{}-{}".format(_release, _arch),
        constraint_values = [
            "prelude//cpu/constraints:{}".format("arm64" if _arch == "aarch64" else _arch),
            "prelude//os/constraints:linux",
            ":ubuntu",
            ":ubuntu-{}".format(_release),
        ],
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("ubuntu", default = "26.04")
    for _arch in ARCHITECTURES
]

[
    constraint_value(
        name = "debian-{}".format(_release),
        constraint_setting = ":release",
        visibility = ["PUBLIC"],
    )
    for _release in flavor_releases("debian", default = "13")
]

[
    platform(
        name = "debian-{}-{}".format(_release, _arch),
        constraint_values = [
            "prelude//cpu/constraints:{}".format("arm64" if _arch == "aarch64" else _arch),
            "prelude//os/constraints:linux",
            ":debian",
            ":debian-{}".format(_release),
